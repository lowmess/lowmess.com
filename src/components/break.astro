---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"div">;

const { class: className, ...props } = Astro.props;
---

<div class:list={["break", className]} {...props}><slot /></div>

<style>
	.break {
		--counter-size: var(--font-size-sm);
		--size: calc(var(--counter-size) + (var(--space-sm) * 2) + 1px);
		position: relative;
		counter-increment: break 1;

		@media (min-width: 30em) {
			--counter-size: var(--font-size-md);
		}

		&::before,
		&::after {
			position: absolute;
			top: calc(var(--size) * -0.125);
			left: calc(
				var(--content-padding-inline-start) * -1 - (var(--size) * 0.5) -
					(var(--outline-width) * 0.5)
			);
			width: var(--size);
			height: var(--size);

			@media print {
				display: none;
			}
		}

		&::before {
			content: "";
			border: var(--outline-width) solid var(--outline-color);
			border-radius: 100%;
			background-color: var(--color-background);
			transition: border-color 0.3s ease;
		}

		&::after {
			content: counter(break);
			translate: -1px;
			font-size: var(--counter-size);
			color: var(--outline-color);
			text-align: center;
			font-weight: 500;
			letter-spacing: -2px;
			transition: color 0.3s ease;
			line-height: var(--size);
		}
	}
</style>
