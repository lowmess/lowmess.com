---
import type { HTMLAttributes } from "astro/types";

import BreakHeading from "#components/break-heading.astro";

type Props = HTMLAttributes<"h2">;

const { class: className, ...props } = Astro.props;
---

<BreakHeading class:list={["heading-two", className]} {...props}
	><slot /></BreakHeading
>

<style>
	.heading-two {
		position: relative;
		top: -0.2lh;
		margin-block-start: calc(var(--rhythm-xl) * 2);
		margin-block-end: var(--rhythm-md);
		font-family: var(--font-family-heading);
		font-size: var(--font-size-xxl);
		color: var(--color-text);
		line-height: var(--line-height-heading);
		text-wrap: balance;
	}

	:global(h2.heading-two code) {
		font-family: var(--font-family-mono);
		font-size: var(--font-size-xl);
		color: inherit;
	}
</style>
