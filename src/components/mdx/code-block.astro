---
import type { HTMLAttributes } from "astro/types";

import Content from "#components/content.astro";

type Props = HTMLAttributes<"pre">;

const { "data-language": lang, style, ...props } = Astro.props;

let languageLabel;

switch (lang) {
	case "astro":
		languageLabel = "Astro";
		break;

	case "ts":
	case "tsx":
		languageLabel = "TypeScript";
		break;

	case "js":
	case "jsx":
		languageLabel = "JavaScript";
		break;

	case "html":
		languageLabel = "HTML";
		break;

	case "css":
		languageLabel = "CSS";
		break;

	case "bash":
	case "sh":
		languageLabel = "Shell";
		break;

	case "json":
		languageLabel = "JSON";
		break;
}
---

<div class="code-container" style={style}>
	<Content class="code-content">
		{
			languageLabel && (
				<span class="language-label" style={style} aria-hidden>
					{languageLabel}
				</span>
			)
		}

		<pre style={style} data-language={lang} {...props}><slot /></pre>
	</Content>
</div>

<style>
	.language-label {
		display: inline-block;
		margin-block: 0;
		font-family: var(--font-family-mono);
		font-size: var(--font-size-xs);
		color: hsl(from currentColor h s l / 0.625);
	}

	.code-container {
		width: 100vw;
		margin-block: var(--rhythm-lg);
		margin-inline: calc(50cqw - 50vw);
		padding-inline: var(--container-padding);
		background-color: light-dark(var(--shiki-light-bg), var(--shiki-dark-bg));
		color: light-dark(var(--shiki-light), var(--shiki-dark));
		overflow-y: visible;
		overflow-x: hidden;
	}

	.code-content {
		padding-block: calc(var(--content-padding) * 0.5);
	}

	pre {
		width: calc(100% + var(--content-padding-start));
		margin-block: 0;
		margin-inline-start: calc(var(--content-padding-start) * -1);
		padding-inline-start: var(--content-padding-start);
		font-size: var(--font-size-sm);
		tab-size: 2;
	}

	:global(.diff) {
		position: relative;
	}

	:global(.diff::before) {
		position: absolute;
		left: calc(var(--content-padding-start) * -0.5);
	}

	:global(.diff.add, .diff.add span) {
		color: light-dark(#448c27, #98c379);
	}

	:global(.diff.add::before) {
		content: "+";
	}

	:global(.diff.remove, .diff.remove span) {
		color: light-dark(#aa3731, #e06c75);

		&::before {
			content: "-";
		}
	}

	:global(.diff.remove::before) {
		content: "-";
	}
</style>
