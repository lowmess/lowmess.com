---
import type { HTMLTag, Polymorphic } from "astro/types";
import { type CollectionEntry } from "astro:content";

import BlogPostPreview from "#components/blog-post-preview.astro";
import NumberedSection from "#components/numbered-section.astro";
import { groupPostsByYear } from "#utils/blog.ts";

type Props<Tag extends HTMLTag> = Polymorphic<{
	as: Tag;
	posts: Array<CollectionEntry<"blog">>;
	headingLevel?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}>;

const {
	as: Tag = "div",
	headingLevel = "h2",
	class: className,
	posts,
	...props
} = Astro.props;

const groups = groupPostsByYear(posts);
---

<Tag
	class:list={["container", className]}
	itemscope
	itemtype="https://schema.org/Blog"
	{...props}
>
	{
		groups.map(({ year, posts }) => (
			<NumberedSection data-count={year.slice(2)} class="year">
				{posts.map((post) => (
					<BlogPostPreview
						post={post}
						headingLevel={headingLevel}
						class="preview"
					/>
				))}
			</NumberedSection>
		))
	}
</Tag>

<style>
	.container,
	.year {
		display: flex;
		flex-direction: column;
		gap: var(--rhythm-md);
		align-items: baseline;

		@media (min-width: 30em) {
			gap: var(--rhythm-lg);
		}

		@media print {
			gap: var(--rhythm-md);
		}
	}

	.preview {
		position: relative;
		top: -0.125lh;
	}
</style>
