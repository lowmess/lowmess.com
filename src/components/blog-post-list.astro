---
import type { HTMLTag, Polymorphic } from "astro/types";
import { type CollectionEntry } from "astro:content";

import BlogPostPreview from "#components/blog-post-preview.astro";
import Break from "#components/break.astro";
import { groupPostsByYear } from "#utils/blog.ts";

type Props<Tag extends HTMLTag> = Polymorphic<{
	as: Tag;
	posts: Array<CollectionEntry<"blog">>;
	headingLevel?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}>;

const {
	as: Tag = "div",
	headingLevel = "h2",
	class: className,
	posts,
	...props
} = Astro.props;

const groups = groupPostsByYear(posts);
---

<Tag
	class:list={["container", className]}
	itemscope
	itemtype="https://schema.org/Blog"
	{...props}
>
	{
		groups.map(({ year, posts }) => (
			<>
				<Break data-year={year.slice(2)} class="break">
					{posts.map((post) => (
						<BlogPostPreview
							post={post}
							headingLevel={headingLevel}
							class="preview"
						/>
					))}
				</Break>
			</>
		))
	}
</Tag>

<style>
	.container,
	.break {
		display: flex;
		flex-direction: column;
		gap: var(--rhythm-md);
		align-items: baseline;

		@media (min-width: 30em) {
			gap: var(--rhythm-lg);
		}
	}

	.break::after {
		content: attr(data-year);
	}

	.preview {
		position: relative;
		top: -0.125lh;
	}
</style>
