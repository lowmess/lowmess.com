---
import type { HTMLTag, Polymorphic } from "astro/types";
import { type CollectionEntry } from "astro:content";

type Props<Tag extends HTMLTag> = Polymorphic<{
	as: Tag;
	headingLevel?: "span" | "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
	project: CollectionEntry<"projects">;
}>;

const {
	as: Tag = "div",
	headingLevel: Heading = "h3",
	class: className,
	project,
	...props
} = Astro.props;

const { title, description, website, repo } = project.data;
---

<Tag
	class:list={["project-preview", className]}
	itemscope
	itemtype="https://schema.org/WebSite"
	{...props}
>
	<Heading class="title" itemprop="name">
		{website || repo ? <a href={website || repo}>{title}</a> : title}
	</Heading>

	<p itemprop="description" set:html={description} />
</Tag>

<style>
	.project-preview {
		p {
			max-width: 55ch;
			margin-block: 0;
			font-size: var(--font-size-md);
			color: var(--color-text-secondary);
		}

		:global(a) {
			color: inherit;
			text-decoration-color: var(--color-text);

			&:hover {
				color: var(--color-text);
			}
		}

		@media print {
			break-inside: avoid;
		}
	}

	.title {
		margin-block: 0;
		font-family: var(--font-family-body);
		font-size: var(--font-size-xxl);
		font-weight: 500;
		list-style-type: none;

		a {
			color: var(--color-text);
			text-decoration: none;

			&:hover {
				color: var(--color-primary);
			}
		}
	}
</style>
