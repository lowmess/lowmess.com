---
import ColorThemeToggle from "#components/color-theme-toggle.astro";
import Logo from "#icons/logo.svg";
---

<nav>
	<div class="skip-link"><a href="#main-content">Skip to main content</a></div>

	<a href="/" class="logo" id="navigation-logo">
		<span class="visually-hidden">Go to homepage</span>
		<Logo aria-hidden />
	</a>

	<div class="nav-items">
		<ul>
			<li>
				<a href="/" data-current={Astro.url.pathname === "/"}>Home</a>
			</li>

			<li>
				<a href="/work" data-current={Astro.url.pathname.includes("/work")}
					>Work</a
				>
			</li>

			<li>
				<a href="/blog" data-current={Astro.url.pathname.includes("/blog")}
					>Blog</a
				>
			</li>
		</ul>

		<ColorThemeToggle class="theme-toggle" />
	</div>
</nav>

<style>
	nav {
		display: flex;
		width: 100%;
		align-items: center;
		justify-content: space-between;
		max-width: var(--content-width);
		margin-block-start: max(
			calc(var(--container-padding-block) * -1),
			env(safe-area-inset-top)
		);
		margin-inline: auto;
		border-inline-start: var(--outline-width) solid var(--outline-color);
		line-height: var(--line-height-solid);
		transition: border-color 0.3s ease;

		@media (min-width: 64em) {
			margin-block-start: max(0, env(safe-area-inset-top));
		}

		@media (min-width: 80em) {
			margin-block-start: max(
				var(--container-padding-block),
				env(safe-area-inset-top)
			);
		}

		@media print {
			margin-block-start: 0;
			margin-block-end: var(--space-lg);
			border: 0;
		}
	}

	.nav-items {
		display: flex;
		align-items: center;
		gap: var(--space-sm);

		@media print {
			display: none;
		}
	}

	ul {
		display: flex;
		align-items: center;
		gap: 0;
		margin: 0;

		&::after {
			content: "";
			position: absolute;
			position-anchor: --nav-item;
			top: anchor(bottom);
			right: anchor(right);
			bottom: anchor(bottom);
			left: anchor(left);
			background-color: var(--color-primary);
			opacity: 0;
			transition:
				opacity 300ms ease,
				inset 650ms
					linear(
						0,
						0.031 0.9%,
						0.12 1.9%,
						0.879 8%,
						1.018 10.2%,
						1.058 11.4%,
						1.078 12.6%,
						1.081 14.8%,
						1.012 21.5%,
						0.994 26.3%,
						1.001 39.9%,
						1
					);
		}

		&:has(a:hover, a[data-current="true"])::after {
			opacity: 1;
			bottom: calc(anchor(bottom) - 2px);
		}

		&:not(:has(a:hover)) li a[data-current="true"] {
			anchor-name: --nav-item;
		}

		li a:hover {
			anchor-name: --nav-item;
		}
	}

	li a {
		padding-block-end: var(--space-xs);
		padding-inline: calc(var(--space-sm) + var(--space-xs));
		font-family: var(--font-family-body);
		color: var(--color-text-secondary);
		text-decoration: none;
		font-size: var(--font-size-sm);
		transition: color 0.3s ease;

		&:hover,
		&[data-current="true"] {
			color: var(--color-text);
		}
	}

	.theme-toggle {
		position: relative;
		top: 1px;
	}

	.skip-link {
		position: absolute;
		top: var(--container-padding-block);
		right: 0;
		left: 0;
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		padding-block-start: var(--rhythm-md);
		opacity: 0;
		pointer-events: none;

		&:focus-within {
			opacity: 1;
			pointer-events: auto;
		}

		a {
			color: var(--color-text);
			text-decoration-color: var(--color-primary);

			&:hover {
				color: var(--color-primary);
			}
		}
	}

	.logo {
		position: relative;
		left: calc(var(--outline-width) * -1);
		display: block;
		width: var(--logo-width);
		aspect-ratio: var(--logo-aspect-ratio);
		color: var(--outline-color);
		line-height: 0;
		transition: color 0.5s ease;

		&:hover {
			color: var(--color-primary);
		}

		svg {
			position: relative;
			z-index: 2;
			width: 100%;
			height: 100%;
		}

		&::before {
			content: "";
			position: absolute;
			top: -2em;
			right: calc(100% - var(--outline-width) * 3);
			bottom: calc(100% - 1px);
			left: calc(var(--outline-width) * -1);
			z-index: 1;
			display: block;
			background-color: var(--color-background);
			pointer-events: none;
			transition: bottom 0.5s
				linear(
					0,
					1 44.7%,
					0.898 51.8%,
					0.874 55.1%,
					0.866 58.4%,
					0.888 64.3%,
					1 77.4%,
					0.98 84.5%,
					1
				);
		}

		&:hover::before {
			bottom: calc(var(--outline-width) * -4);
		}

		@media print {
			color: var(--color-primary);
		}
	}

	:global(body:has(#navigation-logo:hover)) {
		--outline-color: var(--outline-color-muted);
	}
</style>
