---
import ColorThemeToggle from "#components/color-theme-toggle.astro";
import Logo from "#icons/logo.svg";
---

<nav>
	<div class="skip-link"><a href="#main-content">Skip to main content</a></div>

	<a href="/" class="logo" id="navigation-logo">
		<span class="visually-hidden">Go to homepage</span>
		<Logo aria-hidden />
	</a>

	<div class="nav-items">
		<ul>
			<li>
				<a href="/" data-current={Astro.url.pathname === "/"}>Home</a>
			</li>

			<li>
				<a href="/work" data-current={Astro.url.pathname.includes("/work")}
					>Work</a
				>
			</li>

			<li>
				<a href="/blog" data-current={Astro.url.pathname.includes("/blog")}
					>Blog</a
				>
			</li>
		</ul>

		<ColorThemeToggle class="theme-toggle" />
	</div>
</nav>

<style>
	nav {
		display: flex;
		width: 100%;
		align-items: center;
		justify-content: space-between;
		max-width: var(--content-width);
		margin-block-start: calc(var(--container-padding) * -1);
		margin-inline: auto;
		border-inline-start: var(--outline-width) solid var(--outline-color);
		line-height: var(--line-height-solid);
		transition: border-color 0.3s ease;

		@media (min-width: 64em) {
			margin-block-start: 0;
		}

		@media (min-width: 80em) {
			margin-block-start: calc(var(--container-padding) * 2);
		}

		@media print {
			border: 0;
		}
	}

	.nav-items {
		display: flex;
		align-items: center;
		gap: var(--space-lg);

		@media print {
			display: none;
		}
	}

	ul {
		display: flex;
		align-items: center;
		gap: var(--space-md);
		margin: 0;
	}

	li {
		position: relative;
		padding-inline: var(--space-sm);
	}

	li a {
		font-family: var(--font-family-body);
		color: var(--color-text-secondary);
		text-decoration: none;
		font-size: var(--font-size-sm);
		transition: color 0.3s ease;

		&:hover,
		&[data-current="true"] {
			color: var(--color-text);
		}

		&::after {
			content: "";
			position: absolute;
			right: 0;
			bottom: -0.5em;
			left: 0;
			height: 2px;
			background-color: var(--color-text-secondary);
			transform: scaleX(0);
			transform-origin: center;
			transition: transform 0.3s ease;
		}

		&[data-current="true"]::after {
			background-color: var(--color-primary);
		}

		&:hover::after,
		&[data-current="true"]::after {
			transform: scaleX(1);
		}
	}

	.theme-toggle {
		position: relative;
		top: 1px;
	}

	.skip-link {
		position: absolute;
		inset: 0;
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		padding-block-start: var(--rhythm-md);
		opacity: 0;
		pointer-events: none;

		&:focus-within {
			opacity: 1;
			pointer-events: auto;
		}

		a {
			color: var(--color-text);
			text-decoration-color: var(--color-primary);

			&:hover {
				color: var(--color-primary);
			}
		}
	}

	.logo {
		position: relative;
		left: calc(var(--outline-width) * -1);
		display: block;
		width: var(--logo-width);
		aspect-ratio: var(--logo-aspect-ratio);
		color: var(--outline-color);
		line-height: 0;
		transition: color 0.5s ease;

		&:hover {
			color: var(--color-primary);
		}

		svg {
			position: relative;
			z-index: 2;
			width: 100%;
			height: 100%;
		}

		&::before {
			content: "";
			position: absolute;
			top: -1em;
			right: calc(100% - var(--outline-width) * 3);
			bottom: calc(100% - 1px);
			left: calc(var(--outline-width) * -1);
			z-index: 1;
			display: block;
			background-color: var(--color-background);
			pointer-events: none;
			transition: bottom 0.2s ease;
		}

		&:hover::before {
			bottom: calc(var(--outline-width) * -2);
		}

		@media print {
			color: var(--color-primary);
		}
	}

	:global(body:has(#navigation-logo:hover)) {
		--outline-color: var(--outline-color-muted);
	}
</style>
