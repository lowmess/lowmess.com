---
import type { Polymorphic } from "astro/types";

type Props<Tag extends "h1" | "h2"> = Polymorphic<{ as: Tag }>;

const { as: Tag = "h1", class: className, ...props } = Astro.props;
---

<Tag class:list={["headline", className]} {...props}><slot /></Tag>

<style>
	.headline {
		margin-block-start: 0;
		margin-block-end: var(--rhythm-xxl);
		font-size: var(--font-size-title);
		line-height: var(--line-height-solid);
		font-family: var(--font-family-heading);
		text-wrap: balance;
		font-weight: 700;

		@media print {
			margin-block-end: var(--rhythm-md);
		}
	}
</style>
