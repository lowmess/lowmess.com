---
import { getCollection } from "astro:content";

import Content from "#components/content.astro";
import { sortBlogPosts } from "#utils/blog";

const latestPost = (
	await getCollection("blog", ({ data }) => {
		if (data.archived) return false;

		return import.meta.env.PROD ? !data.draft : true;
	})
)
	.sort(sortBlogPosts)
	.shift();
---

<footer>
	<Content class="content">
		<div class="section">
			<h2 data-np-heading>Just listened</h2>
			<p data-np-track>&mdash;</p>
		</div>

		<div class="section">
			{
				latestPost && (
					<>
						<h2>Recent writing</h2>

						<p>
							<a href={`/blog/${latestPost.id}`}>{latestPost.data.title}</a>
						</p>
					</>
				)
			}
		</div>

		<div class="section">
			<h2>On this site</h2>

			<ul>
				<li><a href="/">Home</a></li>
				<li><a href="/work">Work</a></li>
				<li><a href="/blog">Blog</a></li>
				<!-- secret posts: <li><a href="/blog/archive">Graveyard</a></li> -->
				<li><a href="/colophon">Colophon</a></li>
				<li><a href="/uses">Uses</a></li>
				<li><a href="/archive">Archive</a></li>
				<li><a href="/resume">Resum&eacute;</a></li>
				<li><a href="/rss.xml">RSS</a></li>
			</ul>
		</div>

		<div class="section">
			<h2>Around town</h2>

			<ul>
				<li>
					<a href="https://bsky.app/profile/lowmess.com" rel="me">Bluesky</a>
				</li>
				<li>
					<a href="https://letterboxd.com/lowmess/" rel="me">Letterboxd</a>
				</li>
				<li>
					<a href="https://www.last.fm/user/lowmess" rel="me">Last.fm</a>
				</li>
				<li><a href="https://github.com/lowmess" rel="me">GitHub</a></li>
				<li><a href="https://codepen.io/lowmess" rel="me">CodePen</a></li>
				<li><a href="https://sifa.id/p/lowmess.com" rel="me">Sifa</a></li>
				<li>
					<a href="https://linkedin.com/in/lowmess" rel="me">LinkedIn</a>
				</li>
			</ul>
		</div>
	</Content>
</footer>

<script>
	import { LASTFM_API_KEY, LASTFM_USER_NAME } from "astro:env/client";

	const $npHeading = document.querySelector("[data-np-heading]");
	const $npTrack = document.querySelector("[data-np-track]");

	async function getRecentTrack() {
		if (!$npHeading || !$npTrack) {
			return;
		}

		const uri = `https://ws.audioscrobbler.com/2.0/?method=user.getrecenttracks&limit=1&user=${
			LASTFM_USER_NAME
		}&api_key=${LASTFM_API_KEY}&format=json`;

		const res = await fetch(uri);
		const json = await res.json();

		if (json.error) {
			return;
		}

		const track = json.recenttracks.track[0];

		const isNowPlaying = track["@attr"]?.nowplaying === "true";
		const album = track.album["#text"];
		const artist = track.artist["#text"];

		$npHeading.innerHTML = isNowPlaying ? "Now playing" : "Just listened";
		$npTrack.innerHTML = `&#8220;${album}&#8221; by ${artist}`;
	}

	try {
		await getRecentTrack();
	} catch {
		console.log("Failed to fetch/parse latest track from Last.fm");
	}
</script>

<style>
	footer {
		width: 100vw;
		position: relative;
		left: var(--container-padding);
		margin-inline: calc(var(--container-padding) * -2);
		padding-block-end: max(
			var(--container-padding),
			env(safe-area-inset-bottom)
		);
		padding-inline: var(--container-padding);
		background-color: var(--footer-background-color);
		color: var(--footer-text);

		@media (min-width: 64em) {
			padding-block-end: max(
				calc(var(--container-padding) * 2),
				env(safe-area-inset-bottom)
			);
		}

		@media print {
			display: none;
		}
	}

	.content {
		position: relative;
		display: flex;
		flex-direction: column;
		row-gap: var(--rhythm-sm);
		border-inline-start: var(--outline-width) solid var(--outline-color);
		padding-block-start: var(--content-padding);
		padding-block-end: var(--container-padding);
	}

	.section {
		display: flex;
		flex-direction: column;
		gap: var(--rhythm-xs);

		@media (min-width: 40em) {
			flex-direction: row;
			gap: var(--space-md);
		}
	}

	h2 {
		margin-block: 0;
		font-family: var(--font-family-subheading);
		font-size: var(--font-size-sm);
		font-style: normal;
		font-weight: 500;

		@media (min-width: 40em) {
			text-align: end;
		}
	}

	p {
		margin-block: 0;
		font-family: var(--font-family-subheading);
		font-size: var(--font-size-sm);
		font-style: normal;
		font-weight: 500;
		color: var(--footer-text-secondary);
		text-wrap: pretty;
	}

	ul {
		display: flex;
		flex-direction: column;
		gap: var(--rhythm-xs);
		margin: 0;
		padding: 0;

		@media (min-width: 30em) {
			flex-direction: row;
			gap: var(--space-md);
		}
	}

	li {
		font-family: var(--font-family-body);
		font-size: var(--font-size-sm);
		list-style-type: none;
	}

	a {
		color: var(--footer-text-secondary);
		text-decoration: none;

		&:hover {
			color: var(--footer-text);
		}
	}
</style>
