---
import type { HTMLTag, Polymorphic } from "astro/types";

import Break from "#components/break.astro";
import WarningIcon from "#icons/warning.svg";

type Props<Tag extends HTMLTag> = Polymorphic<{
	as: Tag;
	archived: string | Date;
	archiveReason: string;
}>;

const {
	as: Tag = "div",
	archived,
	archiveReason,
	class: className,
	...props
} = Astro.props;

const formatter = new Intl.DateTimeFormat("en-US", {
	dateStyle: "long",
});
---

<Tag class:list={["archive-reason", className]} {...props}>
	<div>
		<p class="date">
			<WarningIcon />

			<span>
				This post was archived on <time
					datetime={archived}
					itemprop="dateModified">{formatter.format(archived)}</time
				></span
			>
		</p>

		<p class="reason" set:html={archiveReason} />
	</div>
</Tag>

<Break class="break" />

<style>
	.icon {
		position: absolute;
		right: calc(100% + var(--space-md));
		top: 2px;
		width: var(--font-size-lg);
		color: var(--color-primary);
	}

	p {
		max-width: 65ch;
	}

	.date {
		display: flex;
		gap: 1ch;
		align-items: baseline;
		margin: 0;
		font-size: var(--font-size-lg);
		color: var(--color-primary);
		text-wrap: pretty;

		svg {
			position: relative;
			top: 2px;
			flex-shrink: 0;
			width: 1em;
		}
	}

	.reason {
		text-wrap: pretty;

		:global(a) {
			text-decoration-color: light-dark(
				var(--color-background),
				var(--color-primary)
			);

			&:hover {
				color: light-dark(var(--color-background), var(--color-primary));
			}
		}
	}

	.break {
		height: 1px;
		margin-block: var(--rhythm-xl);
	}
</style>
