---
import type { HTMLTag, Polymorphic } from "astro/types";

import NumberedSection from "#components/numbered-section.astro";
import WarningIcon from "#icons/warning.svg";

type Props<Tag extends HTMLTag> = Polymorphic<{
	as: Tag;
	archived: string | Date;
	archiveReason: string;
}>;

const {
	as = "div",
	archived,
	archiveReason,
	class: className,
	...props
} = Astro.props;

const formatter = new Intl.DateTimeFormat("en-US", {
	dateStyle: "long",
});
---

<NumberedSection
	as={as}
	class:list={["archive-reason", className]}
	data-count="!"
	{...props}
>
	<div>
		<p class="date">
			<WarningIcon />

			<span>
				This post was archived on <time
					datetime={archived}
					itemprop="dateModified">{formatter.format(archived)}</time
				></span
			>
		</p>

		<p class="reason" set:html={archiveReason} />
	</div>
</NumberedSection>

<style>
	.archive-reason {
		margin-block-end: var(--rhythm-xxl);
		counter-reset: numbered-section -1;
	}

	p {
		max-width: 65ch;
	}

	.date {
		display: flex;
		gap: 1ch;
		align-items: baseline;
		margin: 0;
		font-size: var(--font-size-lg);
		color: var(--color-primary);
		text-wrap: pretty;

		svg {
			display: none;
			position: relative;
			top: 2px;
			flex-shrink: 0;
			width: 1em;

			@media print {
				display: block;
			}
		}
	}

	.reason {
		text-wrap: pretty;

		:global(a) {
			text-decoration-color: light-dark(
				var(--color-background),
				var(--color-primary)
			);

			&:hover {
				color: light-dark(var(--color-background), var(--color-primary));
			}
		}
	}
</style>
