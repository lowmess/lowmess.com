---
import { getCollection, getEntry } from "astro:content";

import NumberedSection from "#components/numbered-section.astro";
import PageHeading from "#components/page-heading.astro";
import ProjectPreview from "#components/project-preview.astro";
import SectionHeading from "#components/section-heading.astro";
import ArrowRight from "#icons/arrow-right.svg";
import GlobalLayout from "#layouts/global.astro";
import { sortProjects } from "#utils/work";

const resumePayload = await getEntry("resume", "1");

if (!resumePayload) {
	console.error("No resume found");
	throw new Error("No resume found");
}

const { data: resume } = resumePayload;

if (!resume.work?.length) {
	console.error("No jobs found");
	throw new Error("No jobs found");
}

const selectedEmployers = resume.work.filter((job) => job.meta?.featured);

const projects = (await getCollection("projects")).sort(sortProjects);
---

<GlobalLayout title="Work">
	<PageHeading>Things I&apos;ve Done</PageHeading>

	<NumberedSection>
		<SectionHeading>Selected employers</SectionHeading>

		<ul>
			{
				selectedEmployers.map((job) => (
					<li>
						<a href={job.website} target="_blank" rel="noopener noreferrer">
							{job.name}
						</a>
					</li>
				))
			}
		</ul>

		<p>
			<a href="/resume" class="resume-link">View resum&eacute; <ArrowRight /></a
			>
		</p></NumberedSection
	>

	<NumberedSection>
		<SectionHeading>Selected projects</SectionHeading>

		<div class="projects">
			{
				projects.map((project) => (
					<ProjectPreview project={project} class="project" />
				))
			}
		</div></NumberedSection
	>
</GlobalLayout>

<style>
	ul {
		display: flex;
		flex-direction: column;
		gap: var(--rhythm-sm);
		margin: 0;
		padding: 0;
	}

	li {
		font-family: var(--font-family-body);
		font-size: var(--font-size-xxl);
		font-weight: 500;
		list-style-type: none;
	}

	a {
		color: inherit;
		text-decoration: none;

		&:hover {
			color: var(--color-primary);
		}
	}

	.resume-link {
		color: var(--color-text-secondary);
		text-decoration: none;

		svg {
			position: relative;
			top: -1px;
			width: 1em;
			transition: transform 0.2s ease;
		}

		&:hover {
			color: var(--color-primary);

			svg {
				transform: translateX(var(--space-xs));
			}
		}

		@media print {
			display: none;
		}
	}

	.projects {
		display: flex;
		flex-direction: column;
		gap: var(--rhythm-md);
	}
</style>
