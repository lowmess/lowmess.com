---
import BreakHeading from "#components/break-heading.astro";
import PageHeading from "#components/page-heading.astro";
import GlobalLayout from "#layouts/global.astro";

import pkg from "../../package-lock.json";

const {
	packages: {
		"node_modules/astro": { version: astroVersion },
		"node_modules/typescript": { version: typescriptVersion },
		"node_modules/sanitize.css": { version: sanitizeCSSVersion },
		"node_modules/shiki": { version: shikiVersion },
		"node_modules/satori": { version: satoriVersion },
		"node_modules/eslint": { version: eslintVersion },
		"node_modules/prettier": { version: prettierVersion },
	},
} = pkg;
---

<GlobalLayout title="Colophon">
	<PageHeading>Colophon</PageHeading>

	<BreakHeading>Typefaces</BreakHeading>

	<ul>
		<li class="framboisier">
			<a href="https://www.futurefonts.com/schmerbertype/framboisier"
				>Framboisier</a
			>
		</li>

		<li class="hanken-grotesk">
			<a href="https://hanken.co/products/hanken-grotesk">Hanken Grotesk</a>
		</li>

		<li class="fira-code">
			<a href="https://github.com/tonsky/FiraCode">Fira Code</a>
		</li>
	</ul>

	<BreakHeading>Packages</BreakHeading>

	<ul class="packages">
		<li>
			<a href="https://astro.build"
				>Astro <span class="version">{astroVersion}</span></a
			>
		</li>

		<li>
			<a href="https://www.typescriptlang.org/"
				>TypeScript <span class="version">{typescriptVersion}</span></a
			>
		</li>

		<li>
			<a href="https://csstools.github.io/sanitize.css/"
				>sanitize.css <span class="version">{sanitizeCSSVersion}</span></a
			>
		</li>

		<li>
			<a href="https://shiki.matsu.io/"
				>Shiki <span class="version">{shikiVersion}</span></a
			>
		</li>

		<li>
			<a href="https://github.com/vercel/satori"
				>Satori <span class="version">{satoriVersion}</span></a
			>
		</li>

		<li>
			<a href="https://eslint.org/"
				>ESLint <span class="version">{eslintVersion}</span></a
			>
		</li>

		<li>
			<a href="https://prettier.io/"
				>Prettier <span class="version">{prettierVersion}</span></a
			>
		</li>
	</ul>

	<BreakHeading>Infrastructure</BreakHeading>

	<ul>
		<li><a href="https://github.com">GitHub</a></li>

		<li><a href="https://netlify.com">Netlify</a></li>
	</ul>
</GlobalLayout>

<style>
	ul {
		display: flex;
		flex-direction: column;
		gap: var(--rhythm-sm);
		margin: 0;
		padding: 0;
	}

	li {
		font-family: var(--font-family-body);
		font-size: var(--font-size-xxl);
		font-weight: 500;
		list-style-type: none;
	}

	a {
		color: var(--color-text);
		text-decoration: none;

		&:hover {
			color: var(--color-primary);
		}
	}

	.version {
		position: relative;
		top: -1px;
		font-family: var(--font-family-mono);
		font-size: var(--font-size-xs);
		color: var(--color-text-secondary);

		&::before {
			content: "v";
		}
	}

	.framboisier {
		font-family: var(--typeface-framboisier);
	}

	.hanken-grotesk {
		font-family: var(--typeface-hanken-grotesk);
	}

	.fira-code {
		font-family: var(--typeface-fira-code);
	}
</style>
