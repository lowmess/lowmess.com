---
import { getCollection } from "astro:content";

import GlobalLayout from "#layouts/global.astro";
import Break from "#components/break.astro";
import { sortBlogPosts } from "#utils/blog";

const latestPost = (
	await getCollection("blog", ({ data }) => {
		if (data.archived) return false;

		return import.meta.env.PROD ? !data.draft : true;
	})
)
	.sort(sortBlogPosts)
	.shift();
---

<GlobalLayout>
	<h1>My name is Alec&nbsp;Lomas, and I make websites.</h1>

	<Break><h2>Introduction</h2></Break>

	<p>
		For over a decade, I have been building marketing &amp; eCommerce websites,
		complex web applications, and my family's fantasy football accounting
		ledger. Coming from a design background, I love to polish user flows and
		sweat the details. Especially when one of my uncles owes me money.
	</p>

	<p>
		I am currently hard at work building the future of construction management
		software at <a href="https://www.ressiosoftware.com/">Ressio</a> from beautiful
		Portland, Oregon.
	</p>

	{
		latestPost && (
			<>
				<Break>
					<h2>Latest blog post</h2>
				</Break>

				<p>
					&ldquo;<a href={`/blog/${latestPost.id}`}>{latestPost.data.title}</a>
					&rdquo;: <span set:html={latestPost.data.description} />
				</p>
			</>
		)
	}

	<style>
		h1 {
			margin-block-start: 0;
			margin-block-end: var(--rhythm-xl);
			font-family: var(--font-family-heading);
			font-style: italic;
			font-size: var(--font-size-title);
			line-height: var(--line-height-solid);
			text-wrap: balance;
		}

		h2 {
			margin-block-start: var(--rhythm-xl);
			font-family: var(--font-family-body);
			font-size: var(--font-size-md);
			font-style: normal;
			font-weight: 400;
			color: var(--color-text-secondary);
		}

		p {
			max-width: 55ch;
			margin: 0;
			font-size: var(--font-size-lg);
			text-wrap: pretty;
		}

		p + p {
			margin-block-start: var(--rhythm-md);
		}

		a {
			color: inherit;
			text-decoration-color: var(--color-primary);
			text-decoration-thickness: 2px;

			&:hover {
				color: var(--color-primary);
			}
		}
	</style>
</GlobalLayout>
