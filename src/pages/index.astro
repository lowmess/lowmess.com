---
import { getCollection } from "astro:content";

import NumberedSection from "#components/numbered-section.astro";
import SectionHeading from "#components/section-heading.astro";
import GlobalLayout from "#layouts/global.astro";
import { sortBlogPosts } from "#utils/blog";

const latestPost = (
	await getCollection("blog", ({ data }) => {
		if (data.archived) return false;

		return import.meta.env.PROD ? !data.draft : true;
	})
)
	.sort(sortBlogPosts)
	.shift();
---

<GlobalLayout>
	<h1>My name is Alec&nbsp;Lomas, and I make websites.</h1>

	<NumberedSection
		><SectionHeading>Introduction</SectionHeading>

		<p>
			For over a decade, I have been building marketing &amp; eCommerce
			websites, complex web applications, and my family's fantasy football
			accounting ledger. Coming from a design background, I love to polish user
			flows and sweat the details. Especially when one of my uncles owes me
			money.
		</p>

		<p>
			I am currently hard at work building the future of construction management
			software at <a href="https://www.ressiosoftware.com/">Ressio</a> from beautiful
			Portland, Oregon.
		</p></NumberedSection
	>

	{
		latestPost && (
			<NumberedSection>
				<SectionHeading>Latest blog post</SectionHeading>

				<p>
					&ldquo;
					<a href={`/blog/${latestPost.id}`}>{latestPost.data.title}</a>
					&rdquo;: <span set:html={latestPost.data.description} />
				</p>
			</NumberedSection>
		)
	}

	<style>
		h1 {
			margin-block-start: 0;
			margin-block-end: var(--rhythm-xl);
			font-family: var(--font-family-heading);
			font-style: italic;
			font-size: var(--font-size-title);
			line-height: var(--line-height-solid);
			text-wrap: balance;
		}

		p {
			max-width: 55ch;
			margin: 0;
			font-size: var(--font-size-lg);
			text-wrap: pretty;
		}

		p + p {
			margin-block-start: var(--rhythm-md);
		}

		a {
			color: inherit;
			text-decoration-color: var(--color-primary);
			text-decoration-thickness: 2px;

			&:hover {
				color: var(--color-primary);
			}
		}
	</style>
</GlobalLayout>
