---
import NumberedSection from "#components/numbered-section.astro";
import PageHeading from "#components/page-heading.astro";
import SectionHeading from "#components/section-heading.astro";
import GlobalLayout from "#layouts/global.astro";
---

<GlobalLayout title="Page not found">
	<NumberedSection data-count=": (" class="sad">
		<SectionHeading as="h1">Error 404</SectionHeading>

		<PageHeading as="h2">Page Not Found</PageHeading>
	</NumberedSection>
</GlobalLayout>

<style>
	h1 {
		font-style: normal;
	}

	h2 {
		font-style: italic;
	}

	.sad::after {
		transform: translateY(-1px) translateX(1px) rotateZ(90deg);

		@media (min-width: 30em) {
			transform: translateY(-1px) translateX(3px) rotateZ(90deg);
		}
	}

	svg {
		position: absolute;
		/* inset: 0; */
		opacity: 0.25;
	}
</style>
