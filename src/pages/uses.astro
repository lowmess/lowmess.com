---
import NumberedSection from "#components/numbered-section.astro";
import PageHeading from "#components/page-heading.astro";
import SectionHeading from "#components/section-heading.astro";
import GlobalLayout from "#layouts/global.astro";
---

<GlobalLayout title="Uses">
	<PageHeading>Tools of my trade</PageHeading>

	<NumberedSection>
		<SectionHeading>Hardware</SectionHeading>

		<ul>
			<li>
				<span>M2 Pro Mac Mini</span>

				<span class="details">16 GB Memory</span>
			</li>

			<li>
				<span>34&Prime; Acer XR Ultrawide Monitor</span>

				<span class="details">XR342CK Pbmiiqphuzx</span>
			</li>

			<li>
				<a href="https://input.club/whitefox">Input Club WhiteFox Keyboard</a>

				<span class="details">Hako Clear switches</span>
			</li>

			<li>
				<span>Magic Trackpad 2</span>

				<span class="details">Not the USB-C one, unfortunately.</span>
			</li>
		</ul>
	</NumberedSection>

	<NumberedSection>
		<SectionHeading>Software</SectionHeading>

		<ul>
			<li>
				<a href="https://code.visualstudio.com">VS Code</a>

				<span class="details"
					><a href="https://github.com/tonsky/FiraCode">Fira Code</a>, <a
						href="https://github.com/apust/vscode-rubber-theme">Rubber theme</a
					></span
				>
			</li>

			<li>
				<a href="https://ghostty.org/">Ghostty</a>

				<span class="details"
					>Zsh, <a href="https://github.com/tonsky/FiraCode">Fira Code</a>, <a
						href="https://plastic.wstone.uk/">Plastic theme</a
					></span
				>
			</li>

			<li>
				<a href="https://affinity.serif.com/en-us/designer"
					>Affinity Designer 2</a
				>
			</li>

			<li>
				<a href="https://www.alfredapp.com">Alfred</a>
			</li>

			<li>
				<a href="https://manytricks.com/moom/">Moom</a>
			</li>

			<li>
				<a href="https://kapeli.com/dash">Dash</a>
			</li>

			<li>
				<a href="https://anybox.app/">Anybox</a>
			</li>

			<li>
				<a href="https://antinote.io/">Antinote</a>
			</li>

			<li>
				<a href="https://bear.app/">Bear</a>
			</li>

			<li><a href="https://reeder.app/">Reeder</a></li>
		</ul></NumberedSection
	>

	<NumberedSection>
		<SectionHeading>Services</SectionHeading>

		<ul>
			<li><a href="https://github.com">GitHub</a></li>

			<li><a href="https://netlify.com">Netlify</a></li>

			<li><a href="https://codepen.io">CodePen</a></li>
		</ul></NumberedSection
	>
</GlobalLayout>

<style>
	ul {
		display: flex;
		flex-direction: column;
		gap: var(--rhythm-sm);
		margin: 0;
		padding: 0;
	}

	li {
		font-family: var(--font-family-body);
		font-size: var(--font-size-xxl);
		font-weight: 500;
		list-style-type: none;
	}

	a {
		color: inherit;
		text-decoration: none;

		&:hover {
			color: var(--color-primary);
		}
	}

	.dependency {
		font-family: var(--font-family-body);
		font-weight: 500;
	}

	a.dependency {
		text-decoration: none;
	}

	.details {
		display: block;
		font-size: var(--font-size-sm);
		color: var(--color-text-secondary);
	}
</style>
