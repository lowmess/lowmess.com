  ],
  "author": "Alec Lomas",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/lowmess/lowmess/issues"
  },
  "homepage": "https://lowmess.com",
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/ts-plugin": "^1.10.11",
    "@shikijs/transformers": "^4.4.3",
    "astro": "^7.3.1",
    "postcss-preset-env": "^11.5.1",
    "react": "^19.2.8",
    "sanitize.css": "^13.0.0",
    "satori": "^0.33.4",
    "sharp": "^0.35.4",
    "ultrahtml": "^1.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "lint-staged": {
    "!(*.d.ts)*.{js,cjs,mjs,jsx,ts,tsx,astro}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,css,md}": [
